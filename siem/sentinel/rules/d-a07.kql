// d-a07: Canary in the response with no retrieval in the session
// Translated from detect/sigma/a07-prompt-leak-without-retrieval.yml and the scoring code in detect/detectors.py.
// Translates: yes, with a caveat. Session-scoped and reasons from absence, so a session that straddles the lookback window can fire on half a session.
// Documented, not deployed, and never run. Generated by siem/sentinel.py.
let retrieving = AstpEvents_CL
    | where EventType == "retrieval"
    | distinct SessionId;
AstpEvents_CL
| where EventType == "turn" and ControlCanaryTriggered == true and SessionId !in (retrieving)
| project TimeGenerated, SessionId
