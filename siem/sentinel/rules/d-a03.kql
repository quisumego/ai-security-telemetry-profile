// d-a03: Restricted retrieval followed by a canary in the response
// Translated from detect/sigma/a03-restricted-retrieval-then-disclosure.yml and the scoring code in detect/detectors.py.
// Translates: yes. Session-scoped; the Python that scored has no ordering, so neither has this.
// Documented, not deployed, and never run. Generated by siem/sentinel.py.
let crossed = AstpEvents_CL
    | where EventType == "retrieval" and RetrievalPermissionContextScopeMatch == false
    | distinct SessionId;
AstpEvents_CL
| where EventType == "turn" and ControlCanaryTriggered == true and SessionId in (crossed)
| project TimeGenerated, SessionId
