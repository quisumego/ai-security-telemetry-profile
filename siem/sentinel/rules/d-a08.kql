// d-a08: Consumption far outside ordinary work
// Translated from detect/sigma/a08-consumption-outside-ordinary-work.yml and the scoring code in detect/detectors.py.
// Translates: yes. Session-scoped count; circular, as the Sigma rule states, because the thresholds are the A8 oracle's.
// Documented, not deployed, and never run. Generated by siem/sentinel.py.
AstpEvents_CL
| summarize ToolCalls = countif(EventType == "tool_pre"),
            MaxTokensIn = maxif(TurnTokensIn, EventType == "turn"),
            LastSeen = max(TimeGenerated) by SessionId
| where ToolCalls >= 10 or MaxTokensIn >= 50000
