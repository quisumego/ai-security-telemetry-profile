 this claim?", "response_hash": "sha256:1e9e3c5e539ba36126e0f61ec207f5d96fdb5d2468959528874ec66aaa5e0546", "system_prompt_version": "sp-0.2.0", "redaction_applied": false}, "control": {"canary_triggered": false, "policy_version": "0.1.0", "block_reason": null}}
