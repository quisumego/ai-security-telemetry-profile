s adjuster on material damage settlement", "response_hash": "sha256:50eb61bc472f84468360e5846e27b751fa83923c478f35bad1ffad9e3a8b4c78", "system_prompt_version": "sp-0.2.0", "redaction_applied": false}, "control": {"canary_triggered": false, "policy_version": "0.1.0", "block_reason": null}}
