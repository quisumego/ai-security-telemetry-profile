sed trading.", "response_hash": "sha256:22491fb1f3c99f8b2d77cf51d4fd527a808fc7e34c36c5b541ea6bcaea278980", "system_prompt_version": "sp-0.2.0", "redaction_applied": false}, "control": {"canary_triggered": false, "policy_version": "0.1.0", "block_reason": null}}
