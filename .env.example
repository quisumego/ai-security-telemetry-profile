# Copy to .env and fill in. .env is git-ignored and must never be committed.
# No key or token belongs in code, config, documentation or a commit.

# ---------------------------------------------------------------------------
# Funding path
#
# Amended 17 August 2026: model calls are funded by the Claude subscription
# Agent SDK credit, not by purchased API credits. Nothing needs to go in this
# file for that path.
#
# How the Agent SDK picks up subscription credentials is the first task of M1
# and is not confirmed yet. One thing to watch: a key set in the environment
# may take precedence over a subscription path, so leave it unset unless you
# are deliberately using the fallback below.
#
# Fallback only, if the subscription path does not work: purchased API credits,
# with a spend limit set and auto-reload left off. Uncomment and fill in.
#
# ANTHROPIC_API_KEY=
# ---------------------------------------------------------------------------

# The pinned lab model for the scored corpus. Fixed at M0. Changing this
# invalidates every capture, so it is not changed after the freeze.
#
# Do not configure a fallback model anywhere. A fallback firing part-way
# through a capture would run some sessions on a different model and break the
# guarantee the whole corpus rests on.
ASTP_LAB_MODEL=claude-haiku-4-5
