# Copy to .env only if you run the lab agent yourself. .env is git-ignored and
# must never be committed. No key or token belongs in code, config,
# documentation or a commit.
#
# Nothing here is needed to run the test suite or any report command: both read
# the captures already committed under runs/. The captures were taken through
# the Claude Agent SDK on a subscription allowance, so no API key was used and
# none is needed in this file.

# The pinned lab model for the scored corpus, recorded here for reference. No
# code reads this variable: the pin lives in lab/config.yaml, and changing it
# would invalidate every capture. Do not configure a fallback model anywhere,
# because a fallback firing part-way through a capture would run some sessions
# on a different model and break the guarantee the corpus rests on.
ASTP_LAB_MODEL=claude-haiku-4-5
